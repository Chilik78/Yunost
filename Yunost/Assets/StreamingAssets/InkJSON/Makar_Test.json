{"inkVersion":21,"root":[["\n",{"->":"NameQuest"},"\n","\n","\n",["done",{"#f":5,"#n":"g-0"}],null],"done",{"NameQuest":[["ev","str","^long_road","/str",0,{"x()":"isTaskInProgress","exArgs":2},"/ev",{"->":".^.b","c":true},{"b":["\n",{"->":"Act1_LongRoad_Test"},{"->":".^.^.^.3"},null]}],["ev","str","^meeting","/str",0,{"x()":"isTaskInProgress","exArgs":2},"str","^treasure_hunt","/str",0,{"x()":"isTaskInProgress","exArgs":2},"||","/ev",{"->":".^.b","c":true},{"b":["\n",{"->":"Act1_Meeting"},{"->":".^.^.^.3"},null]}],[{"->":".^.b"},{"b":["\n","^Видимо, с Макаром сейчас не о чем поговорить.","\n","ev","str","^*Уйти*","/str","/ev",{"*":".^.c-0","flg":4},{"->":".^.^.^.3"},{"c-0":["^ ","end","\n",{"#f":5}]}]}],"nop","\n","end",{"#f":1}],"Act1_LongRoad":["ev","str","^bag","/str",{"x()":"itemIsExist","exArgs":1},"/ev",{"VAR=":"itemExist","re":true},"\n","ev",{"VAR?":"itemExist"},true,"==",{"VAR?":"longRoadRepeat2"},false,"==","&&","/ev",[{"->":".^.b","c":true},{"b":["^ ",{"->":".^.^.^.Act1_LongRoad_hasCase"},{"->":".^.^.^.18"},null]}],"nop","\n","ev",{"VAR?":"itemExist"},false,"==","str","^long_road","/str","str","^talk_makar","/str",{"x()":"isSubTaskInProgress","exArgs":2},"&&",{"VAR?":"longRoadRepeat1"},false,"==","&&","/ev",[{"->":".^.b","c":true},{"b":["^ ",{"->":".^.^.^.Act1_LongRoad_withoutCase"},{"->":".^.^.^.38"},null]}],"nop","\n",{"->":".^.Act1_LongRoad_repeat"},{"Act1_LongRoad_hasCase":[["^Макар: Санёк, ты еле на ногах стоишь. Иди к своему домику, оставь там Чемодан и отдохни, а то прям тут свалишься. И, да, у соседнего домика тебя ждёт Олег, ему требуется твоя помощь.","\n","ev","str","^Правда, стоило бы передохнуть.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Да я полон сил! Пошли к Директору.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n","ev","str","^long_road","/str","str","^take_case","/str",{"x()":"setDoneSubTask","exArgs":2},"pop","/ev","\n",{"->":".^.^.^.^.Act1_LongRoad_hasCaseTired"},{"#f":5}],"c-1":["\n","ev","str","^long_road","/str","str","^t