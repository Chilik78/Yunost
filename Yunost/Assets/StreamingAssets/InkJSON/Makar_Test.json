tr","/ev",{"*":".^.c-0","flg":4},{"c-0":["^ ","end","\n",{"#f":5}]}],{"#f":1}],"next_dialog_failed":[["^Ты проиграл в мини-игре","\n","ev","str","^Ок","/str","/ev",{"*":".^.c-0","flg":4},{"c-0":["^ ","end","\n",{"#f":5}]}],{"#f":1}],"Act1_Meeting":["ev","str","^meeting","/str","str","^talk_counselors","/str",{"x()":"isSubTaskInProgress","exArgs":2},"/ev",[{"->":".^.b","c":true},{"b":["\n",{"->":"Act1_Meeting_Talk"},{"->":".^.^.^.11"},null]}],[{"->":".^.b"},{"b":["\n",{"->":"Act1_Meeting_Repeat"},{"->":".^.^.^.11"},null]}],"nop","\n",{"#f":1}],"Act1_Meeting_Talk":[["^Собрание: Участники собрания стоит полукругом у Анатолия Степановича и кого-то ждут.","\n","ev","str","^Я готов к обсуждению","/str","str","^meeting","/str","str","^talk_counselors","/str",{"x()":"isSubTaskInProgress","exArgs":2},"/ev",{"*":".^.c-0","flg":5},"ev","str","^Осмотреть участников собрания","/str","str","^meeting","/str","str","^talk_counselors","/str",{"x()":"isSubTaskInProgress","exArgs":2},"/ev",{"*":".^.c-1","flg":5},"ev","str","^*Уйти*","/str","/ev",{"*":".^.c-2","flg":4},{"c-0":["^ ",{"->":"Act1_Meeting_TalkCounselors"},"\n",{"#f":5}],"c-1":["^ ",{"->":"Act1_Meeting_CheckCounselors"},"\n",{"#f":5}],"c-2":["^ ","end","\n",{"#f":5}]}],{"#f":1}],"Act1_Meeting_TalkCounselors":[["^Вы: Я готов к обсуждению.","\n","^Анатолий Степанович: О, Александр. Отдохнули? Теперь, когда все в сборе приступим к обсуждению.","\n","^Лиза: Привет, Саш.","\n","^Олег: О, Санёк!","\n","^София: Вот и наше отсутствующее звено.","\n","^Анатолий Степанович: Раз уж мы закончили с приветствиями. Начну. Через несколько дней в лагерь прибудут дети. Ваша задача, как вожатых, придумать для них и подготовить командную соревновательную игру. Задача на сегодня ясна?","\n","ev","str","^Всё понятно. Сейчас мы придумаем игру.","/str","/ev",{"*":".^.c-0","flg":4},{"c-0":["^ ",{"->":"Act1_Meeting_ChooseGame"},"\n",{"#f":5}]}],{"#f":1}],"Act1_Meeting_ChooseGame":[["^Вы: Всё понятно. Сейчас мы придумаем игру.","\n","^Анатолий Степанович: Цель игры - сплочение коллектива и развитие навыков работы в команде. По окончании игры команда должна получить награду. Всё понятно?","\n","^Олег: Да, Анатолий Степанович. У меня уже есть отличная идея. Как насчёт рыбалки?","\n","^Лиза: Неплохая идея, хотя я бы предпочла, чтобы рыбок лишний раз никто не тревожил.","\n","^Макар: Олег я говорю это редко, но твоя мысль мне даже немного нравится.","\n","^София: Ребят, давайте лучше устроим игру на тему поиска сокровищ? Выдадим карты командам и заодно потренируем у них навык ориентирования на местности!","\n","^Лиза: Крутая идея, Сонь! Это будет очень захватывающим!","\n","^Анатолий Степанович: Я вижу у вас уже есть неплохие идеи. Осталось сделать выбор, ибо подготовить за сегодня вы успеете только одну игру. Александр, твой голос мы ещё не слышали.","\n","ev","str","^Мне нравится \"Рыбалка\"","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Давайте подготовим \"Поиск сокровищ\"","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["^ ",{"->":"Act1_Meeting_Fishing"},"\n",{"#f":5}],"c-1":["^ ",{"->":"Act1_Meeting_TreasureHunt"},"\n",{"#f":5}]}],{"#f":1}],"Act1_Meeting_TreasureHunt":[["^Вы: Давайте подготовим \"Поиск сокровищ\".","\n","^София: Спасибо за поддержку, Саш.","\n","^Лиза: Ураа!!!","\n","^Макар: Мда. Как же это банально.","\n","^Олег: Ну, это, конечно, не рыбалка, но что поделать.","\n","^Анатолий Степанович: Решено! Жду от вас игры в тематике \"Остров сокровищ\"","\n","^София: Я уже всё продумала. Я увидела хорошую поляну у костра. Там как раз была лопата. Саш, жду тебя на поляне у костра.","\n","ev","str","^До встречи","/str","/ev",{"*":".^.c-0","flg":4},{"c-0":["\n","ev","str","^Акт 1","/str","str","^sofia_treasure_hunt_fire","/str",{"x()":"applyPlacement","exArgs":2},"pop","/ev","\n","ev","str","^meeting","/str","str","^talk_counselors","/str",{"x()":"setDoneSubTask","exArgs":2},"pop","/ev","\n","ev","str","^fishing","/str",2,{"x()":"setStateTask","exArgs":2},"pop","/ev","\n","end",{"#f":5}]}],{"#f":1}],"Act1_Meeting_Fishing":[["^Вы: Давайте подготовим \"Рыбалку\".","\n","^София: *Удивлённо* Рыбалка?! Ты серьёзно?","\n","^Лиза: Как это рыбалка? Ловить живую рыбу?","\n","^Макар: *Радостно* Вот это правильное решение! Санёк понимает толк в развлечениях!","\n","^Олег: Ура! Вы не пожалеете! Я в рыбалке - профи.","\n","^Анатолий Степанович: Решено! Жду от вас игры по тематике \"Рыбалка\".","\n","^Олег: Сань, подходи к Пристани у берега. Посмотрим, как там обстоит дело с рыбой!","\n","ev","str","^До встречи","/str","/ev",{"*":".^.c-0","flg":4},{"c-0":["\n","ev","str","^Акт 1","/str","str","^oleg_fishing_pier","/str",{"x()":"applyPlacement","exArgs":2},"pop","/ev","\n","ev","str","^meeting","/str","str","^talk_counselors","/str",{"x()":"setDoneSubTask","exArgs":2},"pop","/ev","\n","ev","str","^treasure_hunt","/str",2,{"x()":"setStateTask","exArgs":2},"pop","/ev","\n","end",{"#f":5}]}],{"#f":1}],"Act1_Meeting_Repeat":[["^Макар: Макар стоит намного серьёзней и недружелюбней, чем обычно. Олег тем временем в ярких красках описывает нереализованные идеи, связанные с \"рыбалкой\".","\n","ev","str","^*Уйти*","/str","/ev",{"*":".^.c-0","flg":4},{"c-0":["^ ","end","\n",{"#f":5}]}],{"#f":1}],"Act1_Meeting_CheckCounselors":["end",{"#f":1}],"global decl":["ev","str","^long_road","/str",{"VAR=":"CurrentQuest"},"str","^talk_makar","/str",{"VAR=":"CurrentSubquest"},false,{"VAR=":"itemExist"},false,{"VAR=":"longRoadRepeat1"},false,{"VAR=":"longRoadRepeat2"},false,{"VAR=":"hitGait"},false,{"VAR=":"repeatTalkSearchTools"},false,{"VAR=":"meetDirector"},false,{"VAR=":"picklockExist"},false,{"VAR=":"screwdriverExist"},false,{"VAR=":"toolExist"},false,{"VAR=":"tryToOpenDoor"},false,{"VAR=":"firstCheckDoor"},false,{"VAR=":"doorOpened"},false,{"VAR=":"hitDoor"},false,{"VAR=":"repeatTalkOleg"},false,{"VAR=":"hitDoorTalk"},false,{"VAR=":"passedOleg"},false,{"VAR=":"homeDoorOpened"},false,{"VAR=":"useFishPlace1"},false,{"VAR=":"useFishPlace2"},false,{"VAR=":"useFishPlace3"},false,{"VAR=":"isTalkingDiscus